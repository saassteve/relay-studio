# Default is local-only. For hosting, set all three values below.
# HOST=0.0.0.0
# ADMIN_PASSWORD=replace-with-a-long-unique-password
# PUBLIC_URL=https://relay.example.com
PORT=5173
# ADMIN_EMAIL=you@example.com
# DATA_DIR=/absolute/path/to/relay-data
# Optional local or explicitly consented remote Ollama endpoint:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Desktop generic signed-release feed:
# RELAY_UPDATE_URL=https://downloads.example.com/relay/
# RELAY_SERVER_URL=https://relay.example.com
# FFMPEG_BIN=/absolute/path/to/redistributable/ffmpeg
# Explicitly invoked webhook only:
# RELAY_WEBHOOK_URL=https://your-service.example.com/hook
# RELAY_WEBHOOK_SECRET=your-secret
