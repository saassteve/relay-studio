{
  "name": "relay-video",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/vendor-mediapipe.mjs && node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/vendor-mediapipe.mjs && tsc -b && vite build && node scripts/stamp-sw.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "desktop": "npm run build && node desktop/launch.mjs",
    "desktop:launch": "node desktop/launch.mjs",
    "format": "prettier --write src server desktop tests *.json *.ts index.html",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs",
    "desktop:provision": "node desktop/provision-ffmpeg.mjs",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.config.cjs --mac dir --arm64",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.config.cjs --mac --arm64 --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "archiver": "^7.0.1",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@playwright/test": "^1.56.1",
    "@types/archiver": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.468.0",
    "prettier": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "desktop/main.cjs",
  "overrides": {
    "archiver-utils": {
      "glob": "^14.0.2"
    },
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  },
  "description": "Local-first screen recording, reversible editing and video review.",
  "author": "Relay contributors"
}
